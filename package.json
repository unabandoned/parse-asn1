{
  "name": "@unabandoned/parse-asn1",
  "version": "5.2.2",
  "description": "utility library for parsing asn1 files for use with browserify-sign.",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unabandoned/parse-asn1.git"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@unabandoned/asn1.js": "^5.4.1",
    "@unabandoned/browserify-aes": "^1.4.0",
    "@unabandoned/hash.js": "^1.4.0",
    "pbkdf2": "npm:@unabandoned/pbkdf2@^3.2.1",
    "safe-buffer": "^5.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3"
  },
  "engines": {
    "node": ">= 0.10"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "template": "keepachangelog",
